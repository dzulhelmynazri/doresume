{
  "name": "doresume",
  "private": true,
  "workspaces": {
    "packages": [
      "agents/*",
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/node": "^26.3.0",
      "lucide-react": "^1.34.0",
      "next": "^16.3.3",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@orpc/server": "^1.15.0",
      "@orpc/client": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "@orpc/tanstack-query": "^1.15.0",
      "@tanstack/react-query": "^5.102.5",
      "better-auth": "1.7.1",
      "@tanstack/react-form": "^1.33.5",
      "@polar-sh/better-auth": "^1.8.4",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react-dom": "^19.2.5",
      "tailwindcss": "^4.3.3",
      "tailwind-merge": "^3.6.0",
      "@better-auth/expo": "1.7.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:marketing": "turbo run dev -F marketing --",
    "dev:docs": "turbo run dev -F docs --",
    "dev:apply-agent": "turbo run dev -F apply-agent --",
    "dev:crawler-agent": "turbo run dev -F crawler-agent --",
    "dev:networking-agent": "turbo run dev -F networking-agent --",
    "db:push": "turbo run db:push -F @doresume/db --",
    "db:studio": "turbo run db:studio -F @doresume/db --",
    "db:generate": "turbo run db:generate -F @doresume/db --",
    "db:migrate": "turbo run db:migrate -F @doresume/db --",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@doresume/env": "workspace:*",
    "dotenv": "catalog:",
    "files-sdk": "^2.2.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@doresume/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "ultracite": "^7.10.6"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.14"
}
