{
  "name": "doresume",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next": "^16.3.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "@orpc/server": "^1.14.12",
      "@orpc/client": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "@orpc/tanstack-query": "^1.14.12",
      "@tanstack/react-query": "^5.101.4",
      "better-auth": "1.7.1",
      "@tanstack/react-form": "^1.33.2",
      "@polar-sh/better-auth": "^1.8.4",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3",
      "tailwind-merge": "^3.6.0",
      "@better-auth/expo": "1.7.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @doresume/db --",
    "db:studio": "turbo run db:studio -F @doresume/db --",
    "db:generate": "turbo run db:generate -F @doresume/db --",
    "db:migrate": "turbo run db:migrate -F @doresume/db --",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@doresume/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@doresume/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "ultracite": "7.9.4"
  },
  "packageManager": "bun@1.3.14"
}
